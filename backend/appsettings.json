{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=projectx"
  },
  "Database": {
    "Username": "projectx_user",
    "Password": ""
  },
  "Jwt": {
    "Issuer": "projectx-api",
    "Audience": "projectx-frontend",
    "Key": "CHANGE_ME_SUPER_SECRET_KEY_WITH_MIN_32_CHARS",
    "ExpirationMinutes": 60
  },
  "OpenRouter": {
    "ApiKey": "",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "Model": "anthropic/claude-sonnet-4.5"
  },
  "SystemMonitor": {
    "ServiceName": "ProjectXBackend",
    "LocalControlKey": "",
    "ManagedServices": [
      {
        "Key": "backend",
        "ServiceName": "ProjectXBackend",
        "DisplayName": "ProjectX Backend Service",
        "Port": "5055",
        "IsControllable": true
      },
      {
        "Key": "postgres",
        "ServiceName": "postgresql-x64-16",
        "DisplayName": "PostgreSQL",
        "Port": "5433",
        "IsControllable": true
      }
    ]
  },
  "Hikvision": {
    "ReaderId": 1,
    "CaptureFaceFDID": "1",
    "Username": "admin",
    "Password": "12345",
    "SadpSeedHost": "",
    "SadpSeedPort": 8000,
    "DiscoveryPorts": "80,443,8000",
    "SdkPath": ""
  },
  "System": {
    "TimezoneId": "UTC"
  },
  "DeviceSync": {
    "UseQueue": false,
    "MaxParallelDevices": 44,
    "MaxAttempts": 6,
    "RetryBackoffSeconds": [ 2, 5, 15, 60, 300 ],
    "OfflineRetrySeconds": 60
  },
  "Sadp": {
    "MulticastEnabled": true,
    "PcapEnabled": true,
    "TimeoutSeconds": 10,
    "CheckIpIntervalSeconds": 5
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Storage": {
    "FacesPath": "C:/Users/adil/OneDrive/Desktop/projectx/uploads/faces"
  },
  "AllowedHosts": "*"
}
